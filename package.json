{
  "name": "steam-revenue-extension",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "description": "Approximate Steam game revenue directly on store pages.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser && npm run zip"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.4",
    "@types/node": "24.19.1",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
